{"noir_version":"1.0.0-beta.26+40d6574f851d926f93e0c3a271bac3e6e82ac905","hash":"18412050739832119956","abi":{"parameters":[{"name":"u","type":{"kind":"array","length":5,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"e_extract","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"r_risk","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"l1","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"u_floor","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"budget","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"k_e","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"k_r","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"lam","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"}],"return_type":null,"error_types":{"361444214588792908":{"error_kind":"string","string":"attempt to multiply with overflow"},"1998584279744703196":{"error_kind":"string","string":"attempt to subtract with overflow"},"4303745956696542251":{"error_kind":"string","string":"UCARE: lam * l1 overflow"},"4443992428664939695":{"error_kind":"string","string":"UCARE: k_e * overage overflow"},"7838937380522068191":{"error_kind":"string","string":"UCARE: k_r * r_risk overflow"},"8651376316508390350":{"error_kind":"string","string":"UCARE: d_e + d_r overflow"},"13471728140211736569":{"error_kind":"string","string":"UCARE: Dignity floor violated"},"14761509661750989353":{"error_kind":"string","string":"UCARE: delta_partial + d_m overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"},"16414318616738643241":{"error_kind":"string","string":"UCARE: Invariant gate failed (u_min < delta)"}}},"bytecode":"","debug_symbols":"","file_map":{"52":{"source":"global N: u32 = 5;\nglobal MAX_U64: u64 = 18446744073709551615;\n\nfn main(\n    u: [u64; N],\n    e_extract: u64,\n    r_risk: u64,\n    l1: u64,\n    u_floor: u64,\n    budget: u64,\n    k_e: u64,\n    k_r: u64,\n    lam: u64,\n) {\n    let mut u_min = u[0];\n    for i in 0..N {\n        assert(u[i] >= u_floor, \"UCARE: Dignity floor violated\");\n        if u[i] < u_min {\n            u_min = u[i];\n        }\n    }\n\n    let overage = if e_extract > budget { e_extract - budget } else { 0 };\n\n    let mut d_e: u64 = 0;\n    if (k_e != 0) & (overage != 0) {\n        assert(overage <= (MAX_U64 / k_e), \"UCARE: k_e * overage overflow\");\n        d_e = k_e * overage;\n    }\n\n    let mut d_r: u64 = 0;\n    if (k_r != 0) & (r_risk != 0) {\n        assert(r_risk <= (MAX_U64 / k_r), \"UCARE: k_r * r_risk overflow\");\n        d_r = k_r * r_risk;\n    }\n\n    let mut d_m: u64 = 0;\n    if (lam != 0) & (l1 != 0) {\n        assert(l1 <= (MAX_U64 / lam), \"UCARE: lam * l1 overflow\");\n        d_m = lam * l1;\n    }\n\n    assert(d_e <= MAX_U64 - d_r, \"UCARE: d_e + d_r overflow\");\n    let delta_partial = d_e + d_r;\n    assert(delta_partial <= MAX_U64 - d_m, \"UCARE: delta_partial + d_m overflow\");\n    let delta = delta_partial + d_m;\n\n    assert(u_min >= delta, \"UCARE: Invariant gate failed (u_min < delta)\");\n}\n\n#[test]\nfn test_valid_ucare_state() {\n    let u: [u64; 5] = [6000000, 6500000, 7000000, 6000000, 8000000];\n    main(u, 1050000, 5, 3, 5000000, 1000000, 2, 10000, 50000);\n}\n\n#[test(should_fail_with = \"UCARE: Dignity floor violated\")]\nfn test_fails_dignity_floor() {\n    let u: [u64; 5] = [6000000, 4999999, 7000000, 6000000, 8000000];\n    main(u, 1000000, 0, 0, 5000000, 1000000, 0, 0, 0);\n}\n\n#[test(should_fail_with = \"UCARE: Invariant gate failed (u_min < delta)\")]\nfn test_fails_ucare_gate() {\n    let u: [u64; 5] = [6000000, 6500000, 7000000, 6000000, 8000000];\n    main(u, 1000000, 700, 0, 5000000, 1000000, 0, 10000, 0);\n}\n\n#[test(should_fail_with = \"UCARE: k_r * r_risk overflow\")]\nfn test_fails_multiplication_overflow() {\n    let u: [u64; 5] = [6000000, 6500000, 7000000, 6000000, 8000000];\n    main(u, 1000000, 18446744073709551615, 0, 5000000, 1000000, 0, 2, 0);\n}\n","path":"/workspaces/plp-ucare/src/main.nr","function_locations":[{"start":219,"name":"main"},{"start":1316,"name":"test_valid_ucare_state"},{"start":1543,"name":"test_fails_dignity_floor"},{"start":1774,"name":"test_fails_ucare_gate"},{"start":2008,"name":"test_fails_multiplication_overflow"}]}}}